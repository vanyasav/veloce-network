---
import type { Restaurant } from '../lib/directus';
import { assetUrl } from '../lib/directus';

interface Props {
  restaurant: Restaurant;
}
const { restaurant } = Astro.props;
const heroUrl = assetUrl(restaurant.hero_photo, '?width=1600&quality=80&format=webp');
---

<section id="top" class="relative flex min-h-[70svh] items-end overflow-hidden sm:min-h-[80svh]">
	{heroUrl ? (
		<img
			src={heroUrl}
			alt={restaurant.name}
			class="absolute inset-0 h-full w-full object-cover"
			loading="eager"
			fetchpriority="high"
		/>
	) : (
		<div class="absolute inset-0 bg-[var(--color-secondary)]"></div>
	)}
	<div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-black/10"></div>

	<div class="relative mx-auto w-full max-w-5xl px-4 pb-10 sm:px-6 sm:pb-16">
		<h1 class="text-3xl font-extrabold leading-tight text-white [text-wrap:balance] sm:text-5xl md:text-6xl">
			{restaurant.name}
		</h1>
		{restaurant.address && (
			<p class="mt-3 max-w-md text-base text-white/90 sm:text-lg">{restaurant.address}</p>
		)}
		<div class="mt-6 flex flex-col gap-3 sm:flex-row">
			<a
				href="#menu"
				class="rounded-full bg-[var(--color-primary)] px-6 py-3 text-center text-base font-semibold text-white hover:opacity-90"
			>
				Vedi il menu
			</a>
			{restaurant.phone && (
				<a
					href={`tel:${restaurant.phone.replace(/\s+/g, '')}`}
					class="rounded-full bg-white/95 px-6 py-3 text-center text-base font-semibold text-[var(--color-secondary)] hover:bg-white"
				>
					Prenota: {restaurant.phone}
				</a>
			)}
		</div>
	</div>
</section>
