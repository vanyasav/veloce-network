---
import type { Restaurant } from '../lib/directus';

interface Props {
  restaurant: Restaurant;
}
const { restaurant } = Astro.props;
const hours = restaurant.hours ?? [];
---

{hours.length > 0 && (
	<section id="orari" class="mx-auto max-w-2xl px-4 py-14 sm:px-6 sm:py-20">
		<h2 class="text-2xl font-bold text-[var(--color-secondary)] sm:text-3xl">Orari</h2>
		<dl class="mt-6 divide-y divide-black/10 rounded-xl ring-1 ring-black/5">
			{hours.map((row) => (
				<div class="flex items-center justify-between gap-4 px-4 py-3 sm:px-5">
					<dt class="font-medium text-[var(--color-secondary)]">{row.day}</dt>
					<dd class="text-black/70">
						{row.closed ? 'Chiuso' : `${row.open} – ${row.close}`}
					</dd>
				</div>
			))}
		</dl>
	</section>
)}
